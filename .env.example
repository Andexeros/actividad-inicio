# Copiá este archivo a .env.local y completá los valores.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Secreta! Solo en el servidor (nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# PIN del panel /admin
ADMIN_PIN=
# PIN por defecto para /[iglesia]/host (si la iglesia no tiene host_pin propio en la tabla)
HOST_PIN=

# Secreto para firmar las cookies de sesión de host/admin (string largo al azar)
SESSION_SECRET=

# URL pública que va en el QR (sin barra final). Dejala vacía en local (usa la de la página);
# en Vercel: https://actividadbiblica.vercel.app
NEXT_PUBLIC_SITE_URL=
