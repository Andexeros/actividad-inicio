# Copiá este archivo a .env.local y completá los valores.
# En Vercel, la integración de Supabase ya carga las claves: solo falta ADMIN_PIN.

# Supabase → Project Settings → API (o las que crea la integración de Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Secreta! Solo en el servidor (nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# PIN del panel /admin (4 a 8 números)
ADMIN_PIN=

# Opcional: secreto para firmar la cookie del admin. Si no está, se deriva de una clave de Supabase.
SESSION_SECRET=

# Opcional: URL pública del QR (sin barra final). Si no está, usa la dirección de la página.
NEXT_PUBLIC_SITE_URL=

# Solo para `npm run migrar` (correr las migraciones desde la compu)
POSTGRES_URL_NON_POOLING=
SUPABASE_CA_CERT=supabase/prod-ca-2021.crt

# También se aceptan los nombres de la integración: SUPABASE_URL,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY y SUPABASE_SECRET_KEY.
